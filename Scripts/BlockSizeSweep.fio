[global]
ioengine=libaio
direct=1
size=12G
time_based=1
runtime=45
group_reporting=1
numjobs=1
randrepeat=0
norandommap=1
thread=1
ramp_time=10

# Random read, QD=32
[4k_rand]
rw=randread
bs=4k
iodepth=32

[16k_rand]
rw=randread
bs=16k
iodepth=32

[32k_rand]
rw=randread
bs=32k
iodepth=32

[64k_rand]
rw=randread
bs=64k
iodepth=32

[128k_rand]
rw=randread
bs=128k
iodepth=32

[256k_rand]
rw=randread
bs=256k
iodepth=32

# Sequential read, QD=32
[4k_seq]
rw=read
bs=4k
iodepth=32

[16k_seq]
rw=read
bs=16k
iodepth=32

[32k_seq]
rw=read
bs=32k
iodepth=32

[64k_seq]
rw=read
bs=64k
iodepth=32

[128k_seq]
rw=read
bs=128k
iodepth=32

[256k_seq]
rw=read
bs=256k
iodepth=32